{
  "name": "dataforge",
  "version": "1.0.0",
  "description": "DataForge — Synthetic Data Intelligence Engine",
  "type": "module",
  "scripts": {
    "start": "node -e \"import('./backend/server.js'); import('./dev-server.js');\"",
    "fullstack": "node -e \"import('./backend/server.js'); import('./dev-server.js');\"",
    "dev": "node dev-server.js",
    "serve": "node dev-server.js",
    "frontend": "node dev-server.js",
    "backend": "node backend/server.js",
    "backend:dev": "node --watch backend/server.js",
    "backend:test": "node backend/test-backend.js",
    "backend:seed": "node backend/scripts/seed.js",
    "build": "echo 'Static assets ready'",
    "test": "node test-suite.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  }
}

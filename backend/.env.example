# DataForge Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas Cluster)
MONGO_URI=mongodb://localhost:27017/dataforge
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/dataforge?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=dataforge_super_secure_jwt_secret_key_2026_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
CLIENT_URL=http://localhost:3005
